# WorkLife Backend Environment Variables

PORT=3001
NODE_ENV=development

# Security - REQUIRED in production (minimum 32 characters)
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long

# Database
# Development: leave DATABASE_URL unset to use file-backed local saves
# (backend/data/worklife-memory.json). Production: REQUIRED PostgreSQL.
# DATABASE_URL=postgresql://worklife:worklife_secret@localhost:5432/worklife
# MEMORY_STORE_PATH=./data/worklife-memory.json

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Whose X-Forwarded-For is believed. Unset = loopback and private networks only (the nginx container).
# Behind Cloudflare + nginx set the number of hops to trust, e.g. 2. false = nobody.
# TRUST_PROXY=

# Save import (POST /progression/save/import). Off by default: the save-code key ships in the
# frontend, so a code proves nothing. 1 = accept codes that only roll the account back (see src/save_import.ts).
SAVE_IMPORT_ENABLED=0

# Anonymous retention counters (backend/src/retention_metrics.ts). Unset, shorter than 24 characters, or easy to
# guess (this sample, repeated characters, the same value as JWT_SECRET) = nothing is collected and
# GET /admin/metrics answers 404. Generate one with `openssl rand -hex 24`; send it in the x-admin-key header.
# METRICS_ADMIN_KEY=a_long_random_string_of_24_or_more_characters

# CORS_ORIGIN=https://your-domain.com
