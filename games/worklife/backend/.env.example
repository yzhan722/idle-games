# WorkLife Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Security - REQUIRED in production (minimum 32 characters)
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long

# Database
# - Development: optional. If not set, falls back to in-memory storage (data lost on restart).
# - Production: REQUIRED. The server will refuse to start without it.
DATABASE_URL=postgresql://user:password@localhost:5432/worklife

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# CORS - allowed frontend origins
# - Development: optional. If not set, all origins are allowed for local testing.
# - Production: REQUIRED. If not set, ALL cross-origin requests are rejected and a
#   warning is logged at startup.
# - Supports multiple origins separated by commas (no spaces needed, they are trimmed):
#   CORS_ORIGIN=https://game.example.com,https://www.example.com
# CORS_ORIGIN=https://your-domain.com
