# WorkLife Backend Environment Variables

PORT=3001
NODE_ENV=development

# Security - REQUIRED in production (minimum 32 characters)
JWT_SECRET=your_secure_jwt_secret_at_least_32_characters_long

# Database
# Development: leave DATABASE_URL unset to use file-backed local saves
# (backend/data/worklife-memory.json). Production: REQUIRED PostgreSQL.
# DATABASE_URL=postgresql://worklife:worklife_secret@localhost:5432/worklife
# MEMORY_STORE_PATH=./data/worklife-memory.json

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# CORS_ORIGIN=https://your-domain.com
