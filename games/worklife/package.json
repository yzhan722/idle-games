{
  "name": "worklife",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm test --workspace backend && npm run test:frontend",
    "test:integration": "npm run test:integration --workspace backend",
    "test:e2e": "playwright test",
    "simulate:first-hour": "node --import tsx scripts/simulate-first-hour.ts",
    "verify:art": "node --import tsx scripts/verify-art.ts",
    "capture:art": "node --import tsx scripts/capture-art.ts",
    "verify": "npm run verify:art && npm run build && npm test && npm run test:e2e",
    "test:frontend": "node --import tsx --test frontend/src/gameplay/*.test.ts frontend/src/services/*.test.ts scripts/*.test.ts",
    "test:pg": "node --import tsx --test backend/integration/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
