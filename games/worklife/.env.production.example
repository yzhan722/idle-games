# ============================================
# WorkLife 生产环境配置模板
# ============================================
# 复制此文件为 .env 并填入真实值后使用
# docker-compose 会自动读取项目根目录的 .env 文件

# ---------- PostgreSQL ----------
POSTGRES_USER=worklife
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=worklife

# ---------- Backend ----------
# JWT 密钥（至少 32 字符，建议使用 openssl rand -hex 32 生成）
JWT_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# 限流配置（每 IP 每窗口最多 N 次请求）
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=60000

# CORS 允许的前端来源（逗号分隔多个域名）
CORS_ORIGIN=https://your-domain.com

# ---------- Frontend (可选) ----------
# 如无特殊需求，前端通过 nginx 反向代理，无需额外环境变量
